{
  "name": "mechape",
  "version": "1.11.2",
  "description": "MechApe — local LLM studio: projects, Claude-style skills, and live file knowledge, on your own llama.cpp backend",
  "license": "MIT",
  "author": {
    "name": "Coda Languez",
    "email": "coda@codalanguez.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test-openrouter.js && node scripts/test-llamacpp.js",
    "desktop": "electron .",
    "bench": "node scripts/benchmark.js",
    "runtime": "node scripts/fetch-runtime.js",
    "dist": "node scripts/fetch-runtime.js && node scripts/build-info.js",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codalanguez.mechape",
    "productName": "MechApe",
    "asar": false,
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "server.js",
      "electron/**/*",
      "!electron/runtime/**",
      "lib/**/*",
      "routes/**/*",
      "public/**/*",
      "skills/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icons",
      "category": "Utility",
      "executableName": "mechape"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MechApe"
    }
  }
}
